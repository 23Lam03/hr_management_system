# Server
PORT=5000

# MongoDB connection string.
# IMPORTANT (Phase 12 + Phase 13):
# - Do NOT commit a real Atlas / production URI to source control.
# - The local file `.env` IS git-ignored but credentials have been
#   seen there in past development. Always:
#     1) Use a local MongoDB for development when possible.
#     2) If you must use Atlas for development, create a separate user
#        with read/write on a SINGLE dev database only.
#     3) Rotate any credential that has appeared in a shared/committed
#        artifact (chat transcript, screenshot, repo, terminal history, etc.).
#     4) Restrict Atlas Network Access to your current IP, not 0.0.0.0/0.
# - In production, MONGODB_URI MUST NOT point to localhost (assertConfig
#   refuses to start in that case).
MONGODB_URI=mongodb://127.0.0.1:27017/hrm_database

# JWT secret (use a strong random string in production).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rules (enforced by src/config/env.js → assertConfig):
#   - Must be at least 16 characters in EVERY environment.
#   - In production, must NOT contain placeholder-like fragments
#     (e.g. "change-me", "local-dev", "example-secret"). Replace the
#     default below before going to production.
#   - Use a different value per environment (dev / staging / prod).
#   - Rotating this value invalidates all outstanding JWTs.
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-16-chars

# JWT TTL. Either seconds (e.g. 7200) or a string like "2h", "30m", "7d".
# Short-lived access tokens are recommended; refresh tokens are not in
# scope for Phase 3. There is currently no server-side token revocation,
# so a stolen token is valid until it expires. See
# docs/SECURITY_PERFORMANCE_AUDIT.md §M2 and docs/PRODUCTION_DEPLOYMENT.md
# for the documented limitation.
#
# Phase 14 introduces server-side revocation. The refresh token is
# stored in the Session collection and can be revoked on logout /
# password change / "log out everywhere". The access token is JWT
# and remains valid until its natural `exp` (Plan A — see
# docs/AUTH_SESSION_MANAGEMENT.md §6).
JWT_EXPIRES_IN=2h

# Refresh token TTL (Phase 14). Same format as JWT_EXPIRES_IN.
# Default: 14 days. The Session collection has a TTL index on
# `expiresAt` so expired documents are cleaned up by MongoDB.
# Recommended:
#   development  - 7d   (shorter, so leftover sessions expire faster)
#   staging      - 14d
#   production   - 14d  to 30d (longer is more convenient but means
#                            stolen tokens live longer)
REFRESH_TOKEN_EXPIRES_IN=14d

# Frontend origin allowed by CORS (comma-separated for multiple origins).
# - In development, CORS allows ALL origins unless NODE_ENV=production.
# - In production:
#     * ONLY the origins listed here are accepted.
#     * The localhost default is REFUSED by assertConfig.
#     * Set this to your real frontend URL, e.g.:
#         CLIENT_URL=https://app.example.com
CLIENT_URL=http://localhost:5173

# Environment mode: development | production
# - In production, assertConfig enforces:
#     * JWT_SECRET is not a placeholder
#     * MONGODB_URI is not localhost
#     * CLIENT_URL is not localhost
#     * MONGODB_URI and JWT_SECRET are present
NODE_ENV=development

# ---------------------------------------------------------------------------
# Optional — Phase 13 trust proxy
# ---------------------------------------------------------------------------
# Set only when the app is deployed BEHIND a known reverse proxy
# (nginx, ALB, Cloudflare, etc.). Leaving this unset / empty keeps
# `app.set('trust proxy', ...)` off, which is the safe default.
# Acceptable values:
#   TRUST_PROXY=true            — trust every hop (use only if directly
#                                  behind a trusted L7 proxy)
#   TRUST_PROXY=1               — trust 1 hop (typical for nginx)
#   TRUST_PROXY=loopback        — trust 127.0.0.1, ::1
#   TRUST_PROXY=10.0.0.0/8      — trust a specific subnet
# If you set this incorrectly (e.g. "true" without a real proxy in
# front), clients can spoof their IP via X-Forwarded-For and bypass
# the login rate limiter.
# TRUST_PROXY=

# ---------------------------------------------------------------------------
# Audit log retention (Phase 15)
# ---------------------------------------------------------------------------
# AUDIT_LOG_RETENTION_DAYS controls how long audit log records are
# kept. The value is read by the operator script
# (scripts/cleanup-audit-logs.js). It is NOT applied as a MongoDB
# TTL index — the cleanup is operator-driven.
#
# Rules:
#   - Must be a positive integer (1 - 3650).
#   - If unset / invalid, the application falls back to 365 days.
#   - The destructive call only runs when an operator invokes the
#     script. There is no in-process scheduler.
#
# Recommended starting values:
#   development  - 30
#   staging      - 90
#   production   - 365  (or whatever your compliance posture requires)
AUDIT_LOG_RETENTION_DAYS=365

# AUDIT_LOG_CLEANUP_BATCH_SIZE caps how many records a single
# cleanup invocation will delete. Operators run the script in a
# loop until `hasMore=false`. Default 1000, max 10000.
# AUDIT_LOG_CLEANUP_BATCH_SIZE=1000

# Reserved forward-compat flag. The Phase 15 release does NOT
# auto-enable cleanup; an external scheduler is still required.
# Acceptable values: true | false (case-insensitive). Default: false.
# AUDIT_LOG_CLEANUP_ENABLED=false

# ---------------------------------------------------------------------------
# Observability (Phase 16)
# ---------------------------------------------------------------------------
# LOG_LEVEL: debug | info | warn | error. Default: info in production,
#            debug in development. The logger reads this on every emit
#            so it can be changed at runtime by re-exporting the env.
# LOG_FORMAT: json | text. Default: json in production, text in dev.
#             - "json" emits single-line JSON records (one per line on
#               stdout). Suitable for shipping to ELK / Loki / Datadog.
#             - "text" emits human-readable single lines for local dev.
# The logger STRIPS the following fields from every log record
# (defense in depth): password, passwordHash, token, accessToken,
# refreshToken, tokenHash, jwt, authorization, cookie, secret,
# clientSecret, mongoUri, dbUri, connectionString, email, phone,
# fullName, address, baseSalary/allowances/bonuses/deductions/
# grossSalary/netSalary, ssn, taxId, creditCard, bankAccount.
# LOG_LEVEL=info
# LOG_FORMAT=json
