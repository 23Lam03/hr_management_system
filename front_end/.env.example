# Frontend environment template.
# Copy to `.env` and adjust as needed. NEVER commit `.env` (it is in
# .gitignore). All variables here are exposed to the browser by Vite
# (variables MUST be prefixed with VITE_).

# Base URL of the HRM backend API.
# - Local dev:       http://localhost:5001/api
# - Dev behind proxy: /api (Vite proxies /api -> backend)
# - Production:      https://app.example.com/api
VITE_API_BASE_URL=http://localhost:5001/api

# Set to "true" to fall back to the in-memory mock auth (no backend
# required). Default: false (use the real backend).
VITE_USE_MOCK=false
